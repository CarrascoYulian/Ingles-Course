# ──────────────────────────────────────────────────────────────
# Supabase
# Si estas dos variables faltan, la app arranca en MODO DEMO
# (datos en memoria, sin red). Ver src/lib/env.ts
#
# Dónde encontrarlas: panel de Supabase → Project Settings → API.
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sólo servidor. Nunca exponer con el prefijo NEXT_PUBLIC_.
# Se usa para invitar estudiantes y para firmar subidas a Storage.
SUPABASE_SERVICE_ROLE_KEY=

# Autentica al Vercel Cron Job de /api/storage/reconcile (issue #38).
# Configurala en el proyecto de Vercel (Settings → Environment Variables) —
# Vercel la manda sola como header Authorization en cada invocación
# programada. Cualquier cadena aleatoria larga sirve.
CRON_SECRET=

# ──────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firma la cookie de sesión del modo demo (login sin Supabase). Genera
# cualquier cadena aleatoria larga; no importa una vez haya Supabase real.
DEMO_AUTH_SECRET=

# ──────────────────────────────────────────────────────────────
# Cuentas de prueba del MODO DEMO (sin Supabase configurado).
# Sin estas variables, la pantalla de login no muestra ningún atajo y
# el login demo rechaza cualquier credencial — no hay valores por
# defecto a propósito, para no dejar una puerta trasera conocida.
# El docente entra con correo+contraseña; el alumno también usa
# DEMO_STUDENT_PASSWORD aquí (el modo demo no pasa por Supabase Auth,
# así que no aplica el esquema de matrícula+PIN de abajo).
# ──────────────────────────────────────────────────────────────
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_STUDENT_EMAIL=
DEMO_STUDENT_PASSWORD=

# ──────────────────────────────────────────────────────────────
# Sólo para scripts/seed-users.mjs, con Supabase real conectado.
# Con Supabase, el alumno YA NO entra con contraseña libre: entra con
# su matrícula + un PIN de 4 dígitos (uno por alumno, lo asigna el
# docente al crearlo desde el panel). Esta variable sólo fija el PIN
# del alumno de prueba que crea el script de seed.
# ──────────────────────────────────────────────────────────────
DEMO_STUDENT_PIN=
